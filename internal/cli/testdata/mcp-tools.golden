          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "name": "ajiya_milestone_show"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "readOnlyHint": true
    },
    "description": "Use to pick what to work on: lists the tickets that can start now (open, not blocked, every dependency done), best first.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "app": {
          "description": "Only tickets of this app.",
          "type": "string"
        },
        "launch": {
          "description": "Only tickets the launch target needs.",
          "type": "boolean"
        },
        "milestone": {
          "description": "Only tickets this milestone needs.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "ajiya_next"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "readOnlyHint": false
    },
    "description": "Use when planning a project to add a phase, a stage of work with one goal.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "goal": {
          "description": "What the phase achieves.",
          "type": "string"
        },
        "slug": {
          "description": "Short lowercase name used in file names.",
          "type": "string"
        },
        "title": {
          "description": "Display title.",
          "type": "string"
        }
      },
      "required": [
        "slug",
        "goal"
      ],
      "type": "object"
    },
    "name": "ajiya_phase_add"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "readOnlyHint": true
    },
    "description": "Use to see each phase with its progress and earliest milestone.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {},
      "type": "object"
    },
    "name": "ajiya_phase_list"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "readOnlyHint": true
    },
    "description": "Use at the start of a session to see where the project stands: progress to each milestone, work in progress, what can start, checks and recent activity.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {},
      "type": "object"
    },
    "name": "ajiya_status"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "readOnlyHint": true
    },
    "description": "Use before tagging a ticket to see every tag in use with its ticket count, so you reuse an existing value instead of inventing a near-duplicate (postgres against postgresql).",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {},
      "type": "object"
    },
    "name": "ajiya_tags"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "readOnlyHint": false
    },
    "description": "Use when you find work that is not in the plan: add a ticket instead of widening the current one.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "app": {
          "description": "App name.",
          "type": "string"
        },
        "decisions": {
          "description": "Comma-separated decision IDs, such as DEC-0003.",
          "type": "string"
        },
        "depends": {
          "description": "Comma-separated IDs this ticket depends on.",
          "type": "string"
        },
        "done_when": {
          "description": "The check that proves the ticket is done.",
          "type": "string"
        },
        "human": {
          "description": "Reason, when only a person can do this ticket.",
          "type": "string"
        },
        "paths": {
          "description": "Comma-separated file globs the ticket touches, for open tickets whose files commits cannot show yet.",
          "type": "string"
        },
        "phase": {
          "description": "Phase slug.",
          "type": "string"
        },
        "tech": {
          "description": "Comma-separated technologies or services the ticket depends on, as lower-case slugs such as aws-rds. Leave out unless the ticket needs a specific one; reuse values from ajiya_tags.",
          "type": "string"
        },
        "title": {
          "description": "Ticket title.",
          "type": "string"
        }
      },
      "required": [
        "title",
        "phase",
        "app",
        "done_when"
      ],
      "type": "object"
    },
    "name": "ajiya_ticket_add"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "readOnlyHint": false
    },
    "description": "Use when a ticket is stuck on something outside your control, and say what it waits on. ajiya_ticket_start clears the block later.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Ticket ID, such as AJ-0043.",
          "type": "string"
        },
        "reason": {
          "description": "What the ticket waits on.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "reason"
      ],
      "type": "object"
    },
    "name": "ajiya_ticket_block"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "readOnlyHint": false
    },
    "description": "Use when the ticket's done-when is met and a commit with its Ajiya trailer exists. It refuses without such a commit; this server never makes commits.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "by": {
          "description": "Name of the person who did it (for tickets that need a human).",
          "type": "string"
        },
        "id": {
          "description": "Ticket ID, such as AJ-0043.",
          "type": "string"
        },
        "note": {
          "description": "What was done.",
          "type": "string"
        },
        "test": {
          "description": "Run the project's test command first and refuse if it fails.",
          "type": "boolean"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "name": "ajiya_ticket_done"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "readOnlyHint": false
    },
    "description": "Use to correct a ticket's title, done-when, dependencies, app, phase or tags. Give at least one field; depends, tech, decisions and paths each replace the whole list, and \"-\" clears it.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "app": {
          "description": "New app.",
          "type": "string"
        },
        "decisions": {
          "description": "Comma-separated decision IDs, such as DEC-0003. Replaces the ticket's decision tags; \"-\" clears them.",
          "type": "string"
        },
        "depends": {
          "description": "New dependency list, comma separated, or \"-\" for none.",
          "type": "string"
        },
        "done_when": {
          "description": "New done-when.",
          "type": "string"
        },
        "id": {
          "description": "Ticket ID, such as AJ-0043.",
          "type": "string"
        },
        "paths": {
          "description": "Comma-separated file globs the ticket touches, for open tickets whose files commits cannot show yet. Replaces the ticket's path tags; \"-\" clears them.",
          "type": "string"
        },
        "phase": {
          "description": "New phase slug.",
          "type": "string"
        },
        "tech": {
          "description": "Comma-separated technologies or services the ticket depends on, as lower-case slugs such as aws-rds. Leave out unless the ticket needs a specific one; reuse values from ajiya_tags. Replaces the ticket's tech tags; \"-\" clears them.",
          "type": "string"
        },
        "title": {
          "description": "New title.",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "name": "ajiya_ticket_edit"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "readOnlyHint": true
    },
    "description": "Use to see which files a ticket changed: the union of files in every commit whose Ajiya trailer names it, read from git (plan files in ajiya/ are left out). Empty when no commit names the ticket.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Ticket ID, such as AJ-0043.",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "name": "ajiya_ticket_files"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "readOnlyHint": true
    },
    "description": "Use to find tickets by phase, app, state or milestone, in plan order.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "app": {
          "description": "App name.",
          "type": "string"
        },
        "milestone": {
          "description": "Milestone name.",
          "type": "string"
        },
        "phase": {
          "description": "Phase slug.",
          "type": "string"
        },
        "state": {
          "description": "pending, in_progress, done, dropped, ready or human.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "ajiya_ticket_list"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "readOnlyHint": true
    },
    "description": "Use before starting a ticket, or when you need its done-when, what it waits on, what waits on it, or its commits.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Ticket ID, such as AJ-0043.",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "name": "ajiya_ticket_show"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "readOnlyHint": false
    },
    "description": "Use before you begin work on a ticket. It marks the ticket in progress and clears a block.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Ticket ID, such as AJ-0043.",
          "type": "string"
        },
        "note": {
          "description": "What is left, when resuming.",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "name": "ajiya_ticket_start"
  }
]
