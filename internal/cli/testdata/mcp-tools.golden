  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "readOnlyHint": false
    },
    "description": "Use in the same task that creates a new app folder, so tickets can name it. Create the folder first.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "library": {
          "description": "The app is a shared package.",
          "type": "boolean"
        },
        "name": {
          "description": "App name.",
          "type": "string"
        },
        "path": {
          "description": "Folder of the app, relative to the project.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "path"
      ],
      "type": "object"
    },
    "name": "ajiya_app_add"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "readOnlyHint": true
    },
    "description": "Use before you finish a task to find problems in the plan; fix every error. An empty list means no problems.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "commits": {
          "description": "Also check the commit rule on a revision range, such as origin/main..HEAD.",
          "type": "string"
        },
        "strict": {
          "description": "Treat warnings as failures too.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "name": "ajiya_check"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "readOnlyHint": false
    },
    "description": "Use in a folder that has no ajiya.toml to set up Ajiya there, registering the apps it detects. Equivalent to 'ajiya init --yes'.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Project name (default: the folder name).",
          "type": "string"
        },
        "prefix": {
          "description": "Ticket ID prefix, such as AJ.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "ajiya_init"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "readOnlyHint": false
    },
    "description": "Use when planning to set the launch target: the phase or ticket that means the project has launched.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "target": {
          "description": "A phase slug or a ticket ID.",
          "type": "string"
        }
      },
      "required": [
        "target"
      ],
      "type": "object"
    },
    "name": "ajiya_launch_set"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "readOnlyHint": false
    },
    "description": "Use when planning to add a milestone: a gate that is reached when the phases or tickets it targets are done.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "description": "Place after this milestone.",
          "type": "string"
        },
        "before": {
          "description": "Place before this milestone.",
          "type": "string"
        },
        "name": {
          "description": "Milestone name.",
          "type": "string"
        },
        "targets": {
          "description": "Comma-separated phase slugs or ticket IDs it needs.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "targets"
      ],
      "type": "object"
    },
    "name": "ajiya_milestone_add"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "readOnlyHint": true
    },
    "description": "Use to see progress to each milestone gate, in order.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {},
      "type": "object"
    },
    "name": "ajiya_milestone_list"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "readOnlyHint": true
    },
    "description": "Use to see what one milestone still needs and what blocks it.",
