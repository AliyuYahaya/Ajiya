  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "readOnlyHint": false
    },
    "description": "Use in the same task that creates a new app folder, so tickets can name it. Create the folder first.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "library": {
          "description": "The app is a shared package.",
          "type": "boolean"
        },
        "name": {
          "description": "App name.",
          "type": "string"
        },
        "path": {
          "description": "Folder of the app, relative to the project.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "path"
      ],
      "type": "object"
    },
    "name": "ajiya_app_add"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "readOnlyHint": false
    },
    "description": "Use to record your judgement of one candidate of an open change: unaffected, modify, replace, invalidate or investigate, with a reason. replace needs title and done_when for the new ticket; modify of a done ticket needs them for a follow-up ticket; modify of an open ticket needs title, done_when or both. The other verdicts take neither. Assessing again overwrites the verdict. A person approves; investigate blocks approval.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "done_when": {
          "description": "Done-when of the new ticket, or the edited done-when.",
          "type": "string"
        },
        "id": {
          "description": "Change ID, such as CHG-0014.",
          "type": "string"
        },
        "reason": {
          "description": "Why you chose this verdict.",
          "type": "string"
        },
        "ticket": {
          "description": "Ticket ID of the candidate, such as AJ-0043.",
          "type": "string"
        },
        "title": {
          "description": "Title of the new ticket, or the edited title for modify of an open ticket.",
          "type": "string"
        },
        "verdict": {
          "description": "One of unaffected, modify, replace, invalidate, investigate.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "ticket",
        "verdict",
        "reason"
      ],
      "type": "object"
    },
    "name": "ajiya_change_assess"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "readOnlyHint": false
    },
    "description": "Use after opening a change, and again when tickets change: list the tickets it might affect, each with why (tag, decision, path, downstream), and write them into the change file. Verdicts already given are kept.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Change ID, such as CHG-0014.",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "name": "ajiya_change_impact"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "readOnlyHint": true
    },
    "description": "Use to see every change request with its status.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {},
      "type": "object"
    },
    "name": "ajiya_change_list"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "readOnlyHint": false
    },
    "description": "Use when the plan must change (a technology or decision is being replaced): open a change request. It snapshots the committed plan, so ajiya/ must have no uncommitted changes. Give at least one of replaces, decision or paths. A person approves or rejects the change; you never do.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "description": "Comma-separated decision IDs the change would supersede, such as DEC-0003.",
          "type": "string"
        },
        "paths": {
          "description": "Comma-separated file globs the change touches, such as infra/rds/**.",
          "type": "string"
        },
        "replaces": {
          "description": "Comma-separated key:value tags of the work being replaced, such as tech:aws-rds.",
          "type": "string"
        },
        "title": {
          "description": "What is changing, such as \"Move the database from AWS RDS to Supabase\".",
          "type": "string"
        },
        "with": {
          "description": "Comma-separated key:value tags of what replaces it, such as tech:supabase.",
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "type": "object"
    },
    "name": "ajiya_change_open"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "readOnlyHint": true
    },
    "description": "Use to read a change request in full: what it touches, its candidates, reasons and verdicts.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Change ID, such as CHG-0014.",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "name": "ajiya_change_show"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "readOnlyHint": true
    },
    "description": "Use before you finish a task to find problems in the plan; fix every error. An empty list means no problems.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "commits": {
          "description": "Also check the commit rule on a revision range, such as origin/main..HEAD.",
          "type": "string"
        },
        "strict": {
          "description": "Treat warnings as failures too.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "name": "ajiya_check"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "readOnlyHint": false
    },
    "description": "Use only when a person has said they accept a proposed decision; record their name.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "by": {
          "description": "Name of the person who decided.",
          "type": "string"
        },
        "id": {
          "description": "Decision ID, such as DEC-0003.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "by"
      ],
      "type": "object"
    },
    "name": "ajiya_decision_accept"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "readOnlyHint": false
    },
    "description": "Use when you make or find a choice the plan rests on (a technology, a service, an approach): record it as a Proposed decision. A person accepts it; link tickets to it with ajiya_ticket_edit decisions.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "by": {
          "description": "Who proposed it.",
          "type": "string"
        },
        "consequences": {
          "description": "What follows from it, including what it rules out.",
          "type": "string"
        },
        "context": {
          "description": "Why the choice was needed.",
          "type": "string"
        },
        "decision": {
          "description": "What was chosen.",
          "type": "string"
        },
        "tech": {
          "description": "Comma-separated technologies or services the ticket depends on, as lower-case slugs such as aws-rds. Leave out unless the ticket needs a specific one; reuse values from ajiya_tags.",
          "type": "string"
        },
        "title": {
          "description": "Short title, such as \"Use PostgreSQL on AWS RDS\".",
          "type": "string"
        }
      },
      "required": [
        "title",
        "decision"
      ],
      "type": "object"
    },
    "name": "ajiya_decision_add"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "readOnlyHint": true
    },
    "description": "Use to see every decision with its status, or only those about one technology.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "tag": {
          "description": "Only decisions with this tag, such as tech:postgres.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "ajiya_decision_list"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
