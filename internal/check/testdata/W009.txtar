Milestones in the wrong order: launch already requires everything
staging-proven does, so staging-proven is reached no later than launch.
after-launch needs more than launch, so it is fine.

-- ajiya.toml --
[project]
name = "Fixture"
prefix = "FX"

[[milestones]]
name = "launch"
targets = ["go-live"]

[[milestones]]
name = "staging-proven"
targets = ["FX-0001"]

[[milestones]]
name = "after-launch"
targets = ["later"]
