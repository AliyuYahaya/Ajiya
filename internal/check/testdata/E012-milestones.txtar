A [[milestones]] target that is neither a phase nor a ticket. Each bad target
is named with its milestone; the good ones are not. Milestone warnings wait
until the targets are fixed.

-- ajiya.toml --
[project]
name = "Fixture"
prefix = "FX"

[[milestones]]
name = "staging-proven"
targets = ["core", "gate-0"]

[[milestones]]
name = "launch"
targets = ["FX-0009"]
