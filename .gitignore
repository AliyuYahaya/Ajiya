# Private project data used to test `ajiya import legacy`. Never commit.
reference/private/
__pycache__/

# Build output
/ajiya
!/ajiya/
/ajiya.exe
/dist/

.DS_Store

# Build prompt kept locally, not part of the repository.
ajiya-build-prompt.md

# Share the project's agent skills; keep other .claude/ files (local settings) out.
!.claude/
.claude/*
!.claude/skills/

# The agent kit writes CLAUDE.md (a marked block); keep it even where a global
# gitignore leaves CLAUDE.md out.
!CLAUDE.md

# npm packages built from dist/ (npm/build.mjs)
/npm/dist/
