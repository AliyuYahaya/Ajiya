-- legacy/legacy.toml --
# A made-up legacy project in the collate.py format.
prefixes = ["API", "WEB", "OPS"]
rollout = "rollout/rollout-wbs.md"

[[sources]]
area = "API"
path = "docs/api/wbs.md"

[[sources]]
area = "Web app"
path = "docs/web/wbs.md"

[[sources]]
area = "Operations"
path = "docs/ops/wbs.md"
