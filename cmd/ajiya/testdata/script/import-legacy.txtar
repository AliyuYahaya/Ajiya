-- golden/ajiya.toml --
# Ajiya configuration: https://github.com/AliyuYahaya/Ajiya

[project]
name = "Legacy"
prefix = "LE"

# [launch]
# target = "go-live"          # a phase slug or a ticket ID

# [test]
# command = "go test ./..."   # run by 'ajiya ticket done --test'

# [[apps]]
# name = "api"
# path = "apps/api"

[phases]
order = [
  "ro-1-foundations",
  "ro-2-accounts",
  "ro-3-billing",
  "ro-4-go-live",
  "ro-5-launch-party",
  "inbox",
  "archive",
]

[[milestones]]
name = "gate-0"
targets = ["ro-1-foundations", "ro-2-accounts"]

[[milestones]]
name = "phase-a"
targets = ["ro-3-billing", "ro-4-go-live", "ro-5-launch-party"]

[[apps]]
name = "api"
path = "api"

[[apps]]
name = "web"
path = "web"
