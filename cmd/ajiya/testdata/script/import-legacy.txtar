# import legacy: a made-up project in the collate.py format that covers every
# mapping rule: two areas with their own apps, packages that depend on each
# other, a package without scope, a ticket in two packages, a cross-reference,
# open and done tickets outside every package, two headings and a duplicate
# old ID.

exec ajiya init --name Legacy --prefix LE --yes

# Mistakes in the call or the config change nothing.
! exec ajiya import legacy
stderr 'expected 1 argument'
! exec ajiya import legacy nope.toml
stderr 'no such file'
! exec ajiya import legacy bad/typo.toml
stderr 'unknown key "prefixs"'
! exec ajiya import legacy bad/missing.toml
stderr 'docs/none.md does not exist; fix the path in the config'
! exec ajiya import legacy legacy/legacy.toml --app web
stderr 'app "web" is not registered'
# An app named by a source must be registered too.
! exec ajiya import legacy legacy/legacy.toml
stderr 'source API: app "api" is not registered'
! exists ajiya/inbox.md
! exists ajiya/ro-1-foundations.md

mkdir api
mkdir web
exec ajiya app add api --path api
exec ajiya app add web --path web

exec ajiya import legacy legacy/legacy.toml
cmp stdout report.txt
! stderr .
cmp ajiya.toml golden/ajiya.toml
cmp ajiya/ro-1-foundations.md golden/ro-1-foundations.md
cmp ajiya/ro-2-accounts.md golden/ro-2-accounts.md
cmp ajiya/ro-3-billing.md golden/ro-3-billing.md
cmp ajiya/ro-4-go-live.md golden/ro-4-go-live.md
cmp ajiya/ro-5-launch-party.md golden/ro-5-launch-party.md
cmp ajiya/inbox.md golden/inbox.md
cmp ajiya/archive.md golden/archive.md
! exists ajiya/ro-6-short-row.md
! exists ajiya/api.md
! exists ajiya/rollout.md

# Old IDs still find their tickets; a duplicate finds the first. RO IDs are gone.
exec ajiya ticket show API-003
stdout '^LE-0005  Reset password$'
exec ajiya ticket show LE-0008
stdout 'Was: API-003'
! exec ajiya ticket show RO-2

# Milestones and the phase order come from the headings and the package order.
exec ajiya milestone list
stdout 'gate-0'
stdout 'phase-a'
exec ajiya phase list
stdout '(?s)ro-1-foundations.*ro-2-accounts.*ro-3-billing.*ro-4-go-live.*ro-5-launch-party.*inbox.*archive'

# Only work whose packages' dependencies are done is ready.
exec ajiya next
stdout 'LE-0004'
! stdout 'LE-0009'
! stdout 'LE-0013'

exec ajiya check
stdout '0 error\(s\), 1 warning\(s\)'
stdout 'W010 .*LE-0015'

# Importing the same project twice is refused.
! exec ajiya import legacy legacy/legacy.toml
stderr 'API-001 was already imported as LE-0003; importing this project again would duplicate its tickets'
cmp ajiya/ro-2-accounts.md golden/ro-2-accounts.md

# --json prints the same mapping.
cd $WORK/json
exec ajiya init --name Legacy --prefix LE --yes
mkdir api
mkdir web
exec ajiya app add api --path api
exec ajiya app add web --path web
exec ajiya import legacy ../legacy/legacy.toml --json
cmp stdout ../report.json

# Without a rollout WBS each area file is one phase, and there are no milestones.
cd $WORK/area
exec ajiya init --name Legacy --prefix LE --yes
exec ajiya import legacy area.toml
cmp stdout ../area-report.txt
cmp ajiya/api.md ../golden/area-api.md
exists ajiya/web-app.md
exists ajiya/operations.md
! exists ajiya/inbox.md
! grep milestones ajiya.toml
! grep order ajiya.toml
exec ajiya check
stdout 'No problems found.'

# Work packages that depend on each other: the link that closes the loop is
# left out and reported. --app and a phase key are honoured.
cd $WORK/loop
exec ajiya init --name Loop --prefix LO --yes
mkdir svc
exec ajiya app add svc --path svc
exec ajiya import legacy loop.toml --app svc
stdout '^  ro-1-one: 1 ticket\(s\): 0 done, 0 in progress, 1 pending$'
stdout '^  ro-2-two: 1 ticket\(s\): 0 done, 0 in progress, 1 pending$'
stdout '^  RO-2: depends on RO-1, which would make a dependency loop; not linked$'
grep '^\| LO-0001 \| svc \| First \| - \| LO-0002 \| 🟥 Pending · Was: X-001 \|$' ajiya/ro-1-one.md
grep '^\| LO-0002 \| svc \| Second \| - \| - \| 🟥 Pending · Was: X-002 \|$' ajiya/ro-2-two.md
# The file order puts the first package before the one it now waits on: a warning, not an error.
exec ajiya check
stdout '0 error\(s\), 1 warning\(s\)'
stdout 'W011'



-- bad/typo.toml --
prefixs = ["API"]
-- bad/missing.toml --
prefixes = ["API"]

[[sources]]
area = "API"
path = "../legacy/docs/none.md"
-- report.txt --
Imported 16 ticket(s) from 3 WBS file(s) and 5 work package(s).
  ro-1-foundations: 2 ticket(s): 2 done, 0 in progress, 0 pending
  ro-2-accounts: 6 ticket(s): 2 done, 1 in progress, 2 pending, 1 dropped
  ro-3-billing: 4 ticket(s): 0 done, 0 in progress, 4 pending
  ro-4-go-live: 1 ticket(s): 0 done, 0 in progress, 1 pending
  ro-5-launch-party: 1 ticket(s): 0 done, 0 in progress, 1 pending
  inbox: 1 ticket(s): 0 done, 0 in progress, 1 pending
  archive: 1 ticket(s): 1 done, 0 in progress, 0 pending
  total: 16 ticket(s): 5 done, 1 in progress, 9 pending, 1 dropped
Work packages, now phases:
  RO-1: ro-1-foundations
  RO-2: ro-2-accounts
  RO-3: ro-3-billing
  RO-4: ro-4-go-live
  RO-5: ro-5-launch-party
Milestones, from the headings:
  gate-0: ro-1-foundations, ro-2-accounts
  phase-a: ro-3-billing, ro-4-go-live, ro-5-launch-party
Tickets named by more than one work package, each kept in the first:
  OPS-001 (LE-0001): kept in RO-1, also named by RO-2
Old IDs used by more than one ticket, each now its own ticket ('ajiya ticket show <old ID>' finds the first):
  API-003: LE-0005 (ro-2-accounts), LE-0008 (ro-2-accounts)
Cross-references, dropped so the work counts once:
  RO-2: WEB-002 (LE-0007) dropped, tracked as API-002 (LE-0004); reopen it if it is separate work
In no work package: 1 open ticket(s) in inbox, 1 done in archive.
Not mapped, or read with a guess:
  docs/api/wbs.md: 1 row(s) skipped because the prefix ZZZ- is not in prefixes: ZZZ-001
  docs/api/wbs.md: 1 ticket(s) with no 🟩/🟨/🟥 mark, imported as pending: API-005
  RO-2: scope names API-003, used by more than one ticket, so every one of them is included
  RO-3: scope entries not found: API-099
  RO-5: typed status "Not started" has no mark, read as pending
  rollout/rollout-wbs.md:17: RO-6 has 3 columns, needs 6 (ID, name, scope, depends, launch, status); skipped
  RO-5: depends on RO-9, which does not exist; not linked
