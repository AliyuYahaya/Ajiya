# import legacy: a made-up project in the collate.py format, with a
# duplicate old ID, a range, heading scopes, a cross-reference, a ticket in
# two work packages, and rollout dependencies.

exec ajiya init --name Legacy --prefix LE --yes

# Mistakes in the call or the config change nothing.
! exec ajiya import legacy
stderr 'expected 1 argument'
! exec ajiya import legacy nope.toml
stderr 'no such file'
! exec ajiya import legacy bad/typo.toml
stderr 'unknown key "prefixs"'
! exec ajiya import legacy bad/missing.toml
stderr 'docs/none.md does not exist; fix the path in the config'
! exec ajiya import legacy legacy/legacy.toml --app web
stderr 'app "web" is not registered'
! exists ajiya/api.md

exec ajiya import legacy legacy/legacy.toml
cmp stdout report.txt
! stderr .
cmp ajiya/api.md golden/api.md
cmp ajiya/web-app.md golden/web-app.md
cmp ajiya/operations.md golden/operations.md
cmp ajiya/rollout.md golden/rollout.md

# Old IDs still find their tickets; a duplicate finds the first.
exec ajiya ticket show API-003
stdout '^LE-0003  Reset password$'
exec ajiya ticket show RO-2
stdout '^LE-0015  Accounts$'
exec ajiya ticket show LE-0010
stdout 'Was: API-003'

# Rollout order carries over: only work whose packages' dependencies are done is ready.
exec ajiya next
stdout 'LE-0002'
! stdout 'LE-0004'

exec ajiya check
stdout 'No problems found.'

# Importing the same project twice is refused.
! exec ajiya import legacy legacy/legacy.toml
stderr 'API-001 was already imported as LE-0001; importing this project again would duplicate its tickets'
cmp ajiya/api.md golden/api.md

# Work packages that depend on each other: the link that closes the loop is
# left out and reported. --app and a phase key are honoured.
cd $WORK/loop
exec ajiya init --name Loop --prefix LO --yes
mkdir svc
exec ajiya app add svc --path svc
exec ajiya import legacy loop.toml --app svc
stdout '^  core: 2 ticket\(s\): 0 done, 0 in progress, 2 pending$'
stdout '^  plan: 2 ticket\(s\): 0 done, 0 in progress, 2 pending$'
stdout '^  RO-2: depends on RO-1, which would make a dependency loop; not linked$'
stdout '^  RO-2: X-002 not made to wait on RO-1, which already depends on it; not linked$'
grep '^\| LO-0001 \| svc \| First \| - \| LO-0004 \| 🟥 Pending · Was: X-001 \|$' ajiya/core.md
grep '^\| LO-0003 \| svc \| One \| - \| LO-0001, LO-0004 \| 🟥 Pending · Was: RO-1 \|$' ajiya/plan.md
grep '^\| LO-0004 \| svc \| Two \| - \| LO-0002 \| 🟥 Pending · Was: RO-2 \|$' ajiya/plan.md
exec ajiya check
stdout 'No problems found.'

-- bad/typo.toml --
prefixs = ["API"]
-- bad/missing.toml --
prefixes = ["API"]

[[sources]]
area = "API"
path = "../legacy/docs/none.md"
-- report.txt --
Imported 18 ticket(s) from 3 WBS file(s) and 5 work package(s).
  api: 5 ticket(s): 1 done, 1 in progress, 3 pending
  web-app: 5 ticket(s): 1 done, 1 in progress, 3 pending
  operations: 3 ticket(s): 2 done, 0 in progress, 1 pending
  rollout: 5 ticket(s): 1 done, 1 in progress, 3 pending
  total: 18 ticket(s): 5 done, 3 in progress, 10 pending
Old IDs used by more than one ticket, each now its own ticket ('ajiya ticket show <old ID>' finds the first):
  API-003: LE-0003 (api), LE-0010 (web-app)
Cross-references:
  RO-2: WEB-002 (LE-0007) is the same work as API-002, so it counts once
Not mapped, or read with a guess:
  docs/api/wbs.md: 1 row(s) skipped because the prefix ZZZ- is not in prefixes: ZZZ-001
  docs/api/wbs.md: 1 ticket(s) with no 🟩/🟨/🟥 mark, imported as pending: API-005
  RO-2: scope names API-003, used by more than one ticket, so every one of them is included
  RO-3: scope entries not found: API-099
  RO-5: typed status "Not started" has no mark, read as pending
  rollout/rollout-wbs.md:17: RO-6 has 3 columns, needs 6 (ID, name, scope, depends, launch, status); skipped
  RO-5: depends on RO-9, which does not exist; not linked
  RO-2: OPS-001 not made to wait on RO-1, which already depends on it; not linked
