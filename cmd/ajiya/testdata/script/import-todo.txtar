# import todo: list items land in the inbox phase word for word; ticked items
# are done before Ajiya; importing again adds nothing.

exec ajiya init --name 'Clinic Booking'

! exec ajiya import todo missing.md
stderr 'cannot read missing.md'
! exec ajiya import todo notes/todo.md --app web
stderr 'app "web" is not registered'
! exists ajiya/inbox.md

exec ajiya import todo notes/todo.md
stdout '^Imported 8 item\(s\) into inbox \(3 done before Ajiya\); skipped 0 already imported.$'
cmp ajiya/inbox.md inbox.golden
exec ajiya check --strict
stdout 'No problems found.'

# Importing again is a no-op.
exec ajiya import todo notes/todo.md
stdout '^Imported 0 item\(s\) into inbox \(0 done before Ajiya\); skipped 8 already imported.$'
cmp ajiya/inbox.md inbox.golden

# A status change keeps the link, so the item is still recognised.
exec ajiya ticket start CB-0001
exec ajiya import todo notes/todo.md
stdout 'skipped 8 already imported'
exec ajiya check --strict
stdout 'No problems found.'

-- notes/todo.md --
