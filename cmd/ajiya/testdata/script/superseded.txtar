# superseded tickets keep their evidence, stay out of the totals and required
# sets, and count as closed for what depends on them. status, milestone, phase
# list, ticket list, PROGRESS.md and data.js agree.

exec ajiya init --name Demo --prefix DE
exec ajiya phase add api 'API works'
exec ajiya phase add go-live 'Live'
exec ajiya ticket add --phase api --app infra --done-when x 'Schema'
exec ajiya ticket add --phase api --app infra --done-when x 'Old endpoint'
exec ajiya ticket add --phase api --app infra --done-when x 'Cancelled work'
exec ajiya ticket add --phase api --app infra --done-when x 'New endpoint'
exec ajiya ticket add --phase go-live --app infra --done-when x 'Deploy' --depends DE-0002,DE-0004
exec ajiya milestone add launch --targets go-live
cp api.md ajiya/api.md

exec ajiya check
! stdout 'E0'

# Superseded and dropped are not counted; dependants see them as closed.
exec ajiya milestone show launch --json
stdout '"required": 3'
stdout '"closed": 1'
exec ajiya milestone list
stdout 'launch'
stdout '1 of 3 closed \(33%\)'
exec ajiya phase list
stdout '^api +Api +1/2 '
exec ajiya next
stdout 'DE-0004'
! stdout 'DE-0005'
exec ajiya ticket list --state superseded
stdout 'DE-0002'
stdout 'DE-0003'
! stdout 'DE-0001'
exec ajiya ticket show DE-0002 --json
stdout '"state": "superseded"'
stdout '"superseded_by": "DE-0004"'
stdout '"change": "CHG-0014"'
stdout '"commit": "4f2a91c"'

# The evidence stays; the file is unchanged by reading.
exec ajiya status --json
stdout '"required": 3'

exec ajiya build
grep '^\| launch \| 1 \| 3 \| 33% \| 1 \|$' ajiya/PROGRESS.md
grep '^\| Api \| 1 \| 0 \| 1 \| 2 \| 50% \| launch \|$' ajiya/PROGRESS.md
! grep 'DE-0002' ajiya/PROGRESS.md
grep '"superseded": 2' ajiya/data.js
grep '"state": "superseded"' ajiya/data.js

-- api.md --
<!-- Written by ajiya. Do not edit by hand: use ajiya commands. -->
# Api

Goal: API works

| ID | App | Ticket | Done when | Depends | Tags | Status |
|---|---|---|---|---|---|---|
| DE-0001 | infra | Schema | x | - | - | 🟩 Done · 4f2a91c |
| DE-0002 | infra | Old endpoint | x | - | - | 🟩 Superseded by DE-0004 · CHG-0014 · was: Done · 4f2a91c |
| DE-0003 | infra | Cancelled work | x | - | - | 🟩 Superseded · CHG-0014 · was: Pending |
| DE-0004 | infra | New endpoint | x | DE-0001 | - | 🟥 Pending |
