# The prepare-commit-msg hook pre-fills the trailer.

exec ajiya init --name Demo --prefix DE
exec ajiya phase add core 'Core works'
exec ajiya ticket add --phase core --app infra --done-when x one
exec ajiya ticket add --phase core --app infra --done-when x two
exec ajiya ticket add --phase core --app infra --done-when x three
exec ajiya ticket add --phase core --app infra --done-when x four
cp prepare.sh .git/hooks/prepare-commit-msg
cp commit-msg.sh .git/hooks/commit-msg
chmod 755 .git/hooks/prepare-commit-msg
chmod 755 .git/hooks/commit-msg
chmod 755 editor.sh
exec git add -A

# Nothing in progress: nothing to fill, so commit-msg refuses.
! exec git commit -q -m 'Plan'
stderr 'names no ticket'
! stderr 'added'

# With -m, the tickets in progress are added, and the hook says so.
exec ajiya ticket start DE-0001
exec ajiya ticket start DE-0002
exec git add -A
exec git commit -q -m 'Plan'
stderr 'ajiya: added ''Ajiya: DE-0001, DE-0002'' to the commit message'
exec git log -1 --format=%B
cmp stdout want-plan.txt

# A message that already has a trailer is left alone.
exec git commit -q --allow-empty -m 'Only one' -m 'Ajiya: DE-0002'
exec git log -1 --format=%(trailers:key=Ajiya,valueonly)
stdout '^DE-0002$'

# With an editor, the trailer sits below a blank line under the subject.
env GIT_EDITOR=$WORK/editor.sh
exec git commit -q --allow-empty
exec git log -1 --format=%B
cmp stdout want-editor.txt
env GIT_EDITOR=

# A commit that only changes ajiya/ names the rows that changed.
exec ajiya ticket edit DE-0003 --title 'three, renamed'
exec git add ajiya
exec git commit -q -m 'Rename'
exec git log -1 --format=%(trailers:key=Ajiya,valueonly)
stdout '^DE-0003$'

# More than three candidates with -m: nothing is added and commit-msg explains.
exec ajiya ticket start DE-0003
exec ajiya ticket start DE-0004
exec ajiya ticket edit DE-0001 --title 'one, renamed'
cp notes.txt code.txt
exec git add -A
! exec git commit -q -m 'Too much'
stderr 'names no ticket'
exec git reset -q

# Merges and amends are left alone.
exec git commit -q --amend --no-edit
exec git log -1 --format=%(trailers:key=Ajiya,valueonly)
stdout '^DE-0003$'

-- prepare.sh --
#!/bin/sh
exec ajiya hook run prepare-commit-msg "$@"
-- commit-msg.sh --
#!/bin/sh
exec ajiya hook run commit-msg "$@"
-- editor.sh --
#!/bin/sh
# Types a subject on line 1, as a person would.
{ printf 'Edited subject'; cat "$1"; } > "$1.tmp" && mv "$1.tmp" "$1"
-- notes.txt --
Some code.
-- want-plan.txt --
Plan

Ajiya: DE-0001, DE-0002

-- want-editor.txt --
Edited subject

Ajiya: DE-0001, DE-0002

